# Copy to .env and adjust for your environment.

# Providers: "ollama"/"ollama" for local dev (default). Use "groq"/"fastembed" for
# deployments too small to host Ollama + Llama3-8B (e.g. Render's free tier) --
# see README "Deploying to Render" section.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Ollama (host machine, or the `ollama` service in docker-compose.yml)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3:8b
EMBEDDING_MODEL=nomic-embed-text

# Groq (only used when LLM_PROVIDER=groq) -- free key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# fastembed (only used when EMBEDDING_PROVIDER=fastembed) -- no key needed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Chroma (local persistent store, no server needed)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=knowledge_base
AUTO_INGEST_DIR=./data/documents

# Redis
REDIS_URL=redis://localhost:6379/0
SESSION_HISTORY_MAX_TURNS=6
SESSION_TTL_SECONDS=86400

# Chunking
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# Retrieval
RETRIEVAL_TOP_K=4
SIMILARITY_SCORE_THRESHOLD=0.5
